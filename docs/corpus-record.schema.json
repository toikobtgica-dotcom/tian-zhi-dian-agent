{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/corpus-record.schema.json",
  "title": "Kho Ngon Ngu Corpus Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "source",
    "transcription",
    "deduplication",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source_id", "uri_or_path", "captured_at"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["sangtacviet", "youtube", "mp3", "mp4"]
        },
        "source_id": {
          "type": "string"
        },
        "uri_or_path": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "author_or_channel": {
          "type": "string"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "transcription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_text",
        "corrected_text",
        "language",
        "confidence",
        "low_confidence_segments",
        "review_status"
      ],
      "properties": {
        "raw_text": {
          "type": "string"
        },
        "corrected_text": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "low_confidence_segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end", "text", "confidence"],
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "text": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "review_status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "review_note": {
          "type": "string"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grammar_patterns",
        "style_tags",
        "emotion_tags",
        "summary",
        "analysis_confidence"
      ],
      "properties": {
        "grammar_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "style_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "emotion_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        },
        "analysis_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "deduplication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_url",
        "normalized_text_hash",
        "semantic_fingerprint",
        "status",
        "duplicate_of",
        "similarity"
      ],
      "properties": {
        "canonical_url": {
          "type": ["string", "null"]
        },
        "normalized_text_hash": {
          "type": "string"
        },
        "semantic_fingerprint": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["unique", "exact_duplicate", "near_duplicate", "needs_review"]
        },
        "duplicate_of": {
          "type": ["string", "null"]
        },
        "similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unique"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "duplicate_of": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["exact_duplicate", "near_duplicate"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "duplicate_of": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "updated_at", "pipeline_version"],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "pipeline_version": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transcription": {
            "properties": {
              "review_status": {
                "const": "approved"
              }
            },
            "required": ["review_status"]
          }
        },
        "required": ["transcription"]
      },
      "then": {
        "required": ["analysis"]
      }
    }
  ]
}
